{
  "name": "cms-backend",
  "version": "1.0.0",
  "description": "Complaint Management System Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:stores": "node scripts/seedStores.js",
    "check:layers": "node scripts/checkLayering.js",
    "fix:user-indexes": "node scripts/fixUserIndexes.js",
    "fix:user-indexes:dry": "node scripts/fixUserIndexes.js --dry-run",
    "migrate:users": "node scripts/migrateToUserModel.js",
    "migrate:users:dry": "node scripts/migrateToUserModel.js --dry-run",
    "migrate:created-by": "node scripts/migrateComplaintCreatedBy.js",
    "migrate:created-by:dry": "node scripts/migrateComplaintCreatedBy.js --dry-run",
    "stores:preflight": "node scripts/preflightStores.js",
    "stores:backfill": "node scripts/backfillComplaintStores.js",
    "stores:backfill:dry": "node scripts/backfillComplaintStores.js --dry-run"
  },
  "dependencies": {
    "@fast-csv/format": "^5.0.5",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "twilio": "^4.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
